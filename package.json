{
  "private": true,
  "name": "rust-cache",
  "version": "2.8.0",
  "description": "A GitHub Action that implements smart caching for rust/cargo projects with sensible defaults.",
  "keywords": [
    "actions",
    "rust",
    "cache"
  ],
  "license": "LGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/rust-cache.git"
  },
  "bugs": {
    "url": "https://github.com/step-security/rust-cache/issues"
  },
  "homepage": "https://github.com/step-security/rust-cache#readme",
  "dependencies": {
    "@actions/buildjet-cache": "npm:github-actions.cache-buildjet@0.2.0",
    "@actions/cache": "^4.0.3",
    "@actions/core": "^1.10.1",
    "@actions/exec": "^1.1.1",
    "@actions/glob": "^0.4.0",
    "@actions/io": "^1.1.3",
    "@actions/warpbuild-cache": "npm:github-actions.warp-cache@^1.4.5",
    "axios": "^1.6.2",
    "smol-toml": "^1.4.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.1",
    "linefix": "^0.1.1",
    "typescript": "5.4.3"
  },
  "scripts": {
    "build": "ncc build --target es2020 -o dist/restore src/restore.ts && ncc build --target es2020 -o dist/save src/save.ts && linefix dist"
  }
}
